generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  nutritionGoals UserNutritionGoals?
}

model UserNutritionGoals {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalCalories Int // Daily calorie target (kcal)
  goalProtein  Int // Daily protein target (grams)
  goalCarbs    Int // Daily carbs target (grams)
  goalFat      Int // Daily fat target (grams)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MenuItem {
  id           String   @id @default(cuid())
  recipeId     Int // Hoya Eats recipe ID
  name         String
  station      String? // "Grill", "True Balance", etc.
  mealPeriod   String? // "Breakfast", "Lunch", "Dinner"
  locationSlug String   @default("fresh-food-company")
  servedDate   DateTime // which day's menu
  dietaryTags  String[] // ["Vegan", "Vegetarian", "Made Without Gluten", "Pork"]
  calories     Int?
  protein      Int?
  carbs        Int?
  fat          Int?
  servingSize  String? // "2 Tbsp", "¼ cup"
  allergens    String?
  ingredients  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([recipeId, servedDate, locationSlug])
  @@index([servedDate, locationSlug, mealPeriod])
}
